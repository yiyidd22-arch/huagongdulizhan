{
  "name": "huagongdulizhan",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build && node scripts/prune-news-static-out.mjs",
